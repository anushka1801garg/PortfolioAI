# =============================================================================
# PortfolioAI Root Environment Variable Template (OPS-01)
# =============================================================================
# Reference template for full-stack deployments (Docker, Render, Vercel, Railway).
# Copy to appropriate `.env` or configure inside cloud hosting dashboard.
# NEVER commit real credentials to version control.
# =============================================================================

# =============================================================================
# 1. BACKEND SERVICE (server/.env)
# =============================================================================
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/PortfolioAI?retryWrites=true&w=majority

# Authentication & Cryptography
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=1d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Razorpay Payments (INR Subscriptions)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret
ALLOW_DEMO_PAYMENTS=false

# AI Generation Engine
OPENROUTER_API_KEY=sk-or-v1-placeholder_openrouter_api_key

# Cloudinary Storage (Avatars, Resumes, Deployed Assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Scraper Integrations
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-profile-scraper
RAPIDAPI_KEY=
RAPIDAPI_LINKEDIN_HOST=fresh-linkedin-profile-data.p.rapidapi.com

# Developer Aliases (Local/Staging testing only)
ADMIN_ALIAS_EMAILS=
DEV_ALIAS_EMAILS=
DEV_ADMIN_EMAIL=
DEV_ALIAS_PATTERN=

# =============================================================================
# 2. FRONTEND CLIENT (client/.env)
# =============================================================================
# URL endpoint for backend REST API
VITE_API_URL=http://localhost:8000/api/v1

# Razorpay Key ID for client-side checkout modal
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
