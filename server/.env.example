# =============================================================================
# PortfolioAI Server Environment Variables (OPS-01)
# =============================================================================
# IMPORTANT:
# - Copy this file to `server/.env` for local development.
# - Do NOT commit real credentials or actual secret values to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# [Required] Port number for backend HTTP service
PORT=8000

# [Required] Execution environment (development | production | test)
NODE_ENV=development

# [Required] Frontend client origin(s) permitted for CORS and redirects
# In production, provide comma-separated trusted URLs (e.g. https://portfolioai.app)
CLIENT_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# DATABASE (MONGODB ATLAS)
# -----------------------------------------------------------------------------
# [Required] Full MongoDB connection string with credentials and database name
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/PortfolioAI?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT & CRYPTO)
# -----------------------------------------------------------------------------
# [Required] Secret key for signing and verifying JSON Web Tokens (min 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# [Optional] Token expiration lifetime (default: 1d)
JWT_EXPIRES_IN=1d

# [Required] 32-byte secret key or 64-char hex string for AES-256-GCM token encryption
# Can match or be distinct from JWT_SECRET
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (RAZORPAY)
# -----------------------------------------------------------------------------
# [Required in Production] Razorpay API Key ID (test or live key)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# [Required in Production] Razorpay API Secret
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key

# [Optional] Webhook signing secret configured in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# [Optional] Allow simulated payments in sandbox/development mode (true | false)
ALLOW_DEMO_PAYMENTS=false

# -----------------------------------------------------------------------------
# ARTIFICIAL INTELLIGENCE & LLM (OPENROUTER / GEMINI)
# -----------------------------------------------------------------------------
# [Required for AI Features] OpenRouter API key powering ATS Analyzer & Portfolio Generator
OPENROUTER_API_KEY=sk-or-v1-placeholder_openrouter_api_key

# -----------------------------------------------------------------------------
# CLOUD MEDIA STORAGE (CLOUDINARY)
# -----------------------------------------------------------------------------
# [Required for Image & Resume Uploads] Cloudinary account name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# [Required for Image & Resume Uploads] Cloudinary API key
CLOUDINARY_API_KEY=123456789012345

# [Required for Image & Resume Uploads] Cloudinary API secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# EXTERNAL SCRAPING & IMPORT (OPTIONAL)
# -----------------------------------------------------------------------------
# [Optional] Apify API token for automated LinkedIn profile imports
APIFY_API_TOKEN=

# [Optional] Apify actor identifier
APIFY_LINKEDIN_ACTOR=harvestapi~linkedin-profile-scraper

# [Optional] RapidAPI key for secondary fallback scraper
RAPIDAPI_KEY=

# [Optional] RapidAPI LinkedIn host header
RAPIDAPI_LINKEDIN_HOST=fresh-linkedin-profile-data.p.rapidapi.com

# -----------------------------------------------------------------------------
# DEVELOPER ALIASES & LOCAL DEBUGGING (DEV ONLY)
# -----------------------------------------------------------------------------
# [Dev Only] Comma-separated admin alias email addresses for cross-account testing
ADMIN_ALIAS_EMAILS=
DEV_ALIAS_EMAILS=
DEV_ADMIN_EMAIL=
DEV_ALIAS_PATTERN=
